{
  "info": {
    "name": "7Arts Vouchers API",
    "description": "Complete API collection for 7Arts gift vouchers system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "adminApiKey",
      "value": "your_api_key_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public Endpoints",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "API Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        },
        {
          "name": "Create Checkout Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 150,\n  \"currency\": \"bgn\",\n  \"quantity\": 1,\n  \"voucherType\": \"individual\",\n  \"voucherFormat\": \"digital\",\n  \"customerEmail\": \"customer@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/create-checkout-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "create-checkout-session"]
            }
          }
        },
        {
          "name": "Validate Voucher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"7ARTS-A5K9-L2M4\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vouchers/validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vouchers", "validate"]
            }
          }
        },
        {
          "name": "Redeem Voucher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"7ARTS-A5K9-L2M4\",\n  \"customerEmail\": \"customer@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vouchers/redeem",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vouchers", "redeem"]
            }
          }
        },
        {
          "name": "Check Voucher",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vouchers/check/7ARTS-A5K9-L2M4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vouchers", "check", "7ARTS-A5K9-L2M4"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Endpoints (API Key)",
      "item": [
        {
          "name": "Get All Vouchers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/vouchers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "vouchers"]
            }
          }
        },
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "stats"]
            }
          }
        },
        {
          "name": "Get Voucher by Code",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/vouchers/7ARTS-A5K9-L2M4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "vouchers", "7ARTS-A5K9-L2M4"]
            }
          }
        },
        {
          "name": "Search by Email",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/search?email=customer@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "search"],
              "query": [
                {
                  "key": "email",
                  "value": "customer@example.com"
                }
              ]
            }
          }
        },
        {
          "name": "Search by Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/search?status=active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "search"],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          }
        },
        {
          "name": "Search by Type",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/search?type=individual",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "search"],
              "query": [
                {
                  "key": "type",
                  "value": "individual"
                }
              ]
            }
          }
        },
        {
          "name": "Search by Amount Range",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/search?minAmount=100&maxAmount=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "search"],
              "query": [
                {
                  "key": "minAmount",
                  "value": "100"
                },
                {
                  "key": "maxAmount",
                  "value": "200"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Endpoints (Basic Auth)",
      "item": [
        {
          "name": "Get All Vouchers (Basic Auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/vouchers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "vouchers"]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "admin",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "your_password_here",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get Statistics (Basic Auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "stats"]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "admin",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "your_password_here",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
