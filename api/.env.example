# Server Configuration
PORT=3001
NODE_ENV=development

# Stripe Configuration
# Вземи ги от: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Client Configuration
CLIENT_URL=https://vouchers.7arts.bg

# Admin Authentication
# Избери един от двата метода:

# Method 1: Username & Password (Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Method 2: API Key (X-API-Key header)
ADMIN_API_KEY=your_api_key_here

# ⚠️ ВАЖНО: Смени тези стойности в production!
# Генерирай силна парола или API key

# За production използвай production Stripe keys:
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
